__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local credentials and environment configuration.
.env
.env.*
!.env.example

# Material de referência fornecido pelo usuário: confirme os direitos antes de publicar.
sources/*.pdf

